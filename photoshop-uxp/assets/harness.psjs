/* ============================================================================
 * Photoshop UXP agent harness — COPY THIS, put your edits in the marked block.
 *
 * A .psjs runs ALREADY-MODAL: call DOM/batchPlay directly, NO core.executeAsModal.
 * Top-level await is allowed. Trigger it (Photoshop must be running):
 *     APP=$(ls /Applications | grep -i '^Adobe Photoshop' | head -1)  # whatever's installed
 *     open -a "$APP" /abs/path/to/this.psjs
 * It writes preview.jpg + state.json to the temp folder. console.log is NOT
 * visible externally — find the output on disk by mtime instead:
 *     find /var/folders -path '*Adobe/UXP/PluginsStorage*External*' \
 *          -name state.json -newer /tmp/marker 2>/dev/null | head -1
 * Then look at preview.jpg (errors:[] does NOT mean it looks right) and read state.json.
 * ========================================================================== */
const { app, action, constants } = require("photoshop");
const { localFileSystem: fs } = require("uxp").storage;
const errors = [];

/** Run batchPlay descriptors; record (don't throw on) Photoshop's error shape. */
async function bp(descriptors, label) {
  const res = await action.batchPlay(descriptors, { continueOnError: true });
  for (const r of res) {
    if (r && r._obj === "error") errors.push({ label, message: r.message, result: r.result });
  }
  return res;
}

/** Read raw Action-Manager properties off a target the DOM doesn't expose well.
 *  This is the ScriptListener/Alchemist trick distilled: a `multiGet` get-descriptor.
 *    target: a _ref chain, e.g. [{_ref:"layer",_id:5}, {_ref:"document",_enum:"ordinal"}]
 *    props:  string[] of property names, e.g. ["opacity","bounds","mode"]
 *  Returns the property descriptor ({} on failure — recorded in errors), giving a
 *  STRUCTURED second channel of truth alongside the preview pixels. */
async function readback(target, props, label) {
  try {
    const [res] = await action.batchPlay(
      [{ _obj: "multiGet", _target: target,
         extendedReference: [props], options: { failOnMissingProperty: false } }],
      { continueOnError: true });
    if (res && res._obj === "error") { errors.push({ label: label || "readback", message: res.message }); return {}; }
    return res || {};
  } catch (e) { errors.push({ label: label || "readback", message: String(e) }); return {}; }
}

/** A text layer's fill color via the DOM (since 24.1). The #1 verification gap:
 *  "errors:[] but the text is black-on-black." Returns {red,green,blue} 0-255 or null. */
function textColor(layer) {
  try {
    const c = layer.textItem.characterStyle.color.rgb;
    return { red: Math.round(c.red), green: Math.round(c.green), blue: Math.round(c.blue) };
  } catch (e) { return null; }
}

/** Recursively snapshot a layer to plain JSON for the readback contract. */
function snapshotLayer(layer) {
  const n = {
    id: layer.id, name: layer.name, kind: String(layer.kind),
    visible: layer.visible, opacity: layer.opacity, blendMode: String(layer.blendMode),
    bounds: layer.bounds && {
      left: layer.bounds.left, top: layer.bounds.top,
      right: layer.bounds.right, bottom: layer.bounds.bottom,
    },
  };
  if (layer.kind === constants.LayerKind.TEXT) {
    try { n.text = layer.textItem.contents; } catch (e) {}
    n.textColor = textColor(layer);   // so the agent can catch invisible text without eyeballing
  }
  if (layer.layers && layer.layers.length) n.children = layer.layers.map(snapshotLayer);
  return n;
}

/** Emit preview.jpg + state.json to the temp folder. Call this LAST. */
async function emit(doc, extra) {
  const out = await fs.getTemporaryFolder();
  try {
    const pf = await out.createFile("preview.jpg", { overwrite: true });
    await doc.saveAs.jpg(pf, { quality: 9 }, /* asCopy */ true);
  } catch (e) { errors.push({ label: "emit preview", message: String(e) }); }
  const state = {
    document: { id: doc.id, name: doc.title, width: doc.width, height: doc.height, resolution: doc.resolution },
    layers: doc.layers.map(snapshotLayer),
    errors,
    ...(extra || {}),
  };
  const sf = await out.createFile("state.json", { overwrite: true });
  await sf.write(JSON.stringify(state, null, 2));
}

