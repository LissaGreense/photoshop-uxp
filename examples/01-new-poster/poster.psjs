/* ============================================================================
 * EXAMPLE 01 — Generate an editorial poster from nothing
 * Shows: create a document, a warm paper fill, a hairline rule, and real type —
 *        a serif display face (Didot), tracked sans label, serif italic caption,
 *        each with EXPLICIT font + size + tracking + color (none are inherited).
 *
 * The top half (down to "YOUR WORK BELOW") is the canonical harness, verbatim
 * from photoshop-uxp/assets/harness.psjs. Run it (Photoshop must be running):
 *     APP=$(ls /Applications | grep -i '^Adobe Photoshop' | head -1)
 *     open -a "$APP" "$(pwd)/poster.psjs"
 * ========================================================================== */
const { app, action, constants } = require("photoshop");
const { localFileSystem: fs } = require("uxp").storage;
const errors = [];

async function bp(descriptors, label) {
  const res = await action.batchPlay(descriptors, { continueOnError: true });
  for (const r of res) {
    if (r && r._obj === "error") errors.push({ label, message: r.message, result: r.result });
  }
  return res;
}

function snapshotLayer(layer) {
  const n = {
    id: layer.id, name: layer.name, kind: String(layer.kind),
    visible: layer.visible, opacity: layer.opacity, blendMode: String(layer.blendMode),
    bounds: layer.bounds && { left: layer.bounds.left, top: layer.bounds.top, right: layer.bounds.right, bottom: layer.bounds.bottom },
  };
  if (layer.kind === constants.LayerKind.TEXT) { try { n.text = layer.textItem.contents; } catch (e) {} }
  if (layer.layers && layer.layers.length) n.children = layer.layers.map(snapshotLayer);
  return n;
}

async function emit(doc, extra) {
  const out = await fs.getTemporaryFolder();
  try {
    const pf = await out.createFile("preview.jpg", { overwrite: true });
    await doc.saveAs.jpg(pf, { quality: 9 }, true);
  } catch (e) { errors.push({ label: "emit preview", message: String(e) }); }
  const state = {
    document: { id: doc.id, name: doc.title, width: doc.width, height: doc.height, resolution: doc.resolution },
    layers: doc.layers.map(snapshotLayer), errors, ...(extra || {}),
  };
  const sf = await out.createFile("state.json", { overwrite: true });
  await sf.write(JSON.stringify(state, null, 2));
}

async function selectRect(t, l, b, r) {
  await bp([{ _obj: "set", _target: [{ _ref: "channel", _property: "selection" }],
    to: { _obj: "rectangle", top: { _unit: "pixelsUnit", _value: t }, left: { _unit: "pixelsUnit", _value: l },
          bottom: { _unit: "pixelsUnit", _value: b }, right: { _unit: "pixelsUnit", _value: r } } }], "select rect");
}
async function deselect() {
  await bp([{ _obj: "set", _target: [{ _ref: "channel", _property: "selection" }],
    to: { _enum: "ordinal", _value: "none" } }], "deselect");
}
async function fillLayer(doc, [r, g, b], name) {  // solid fill layer; auto-masks to any active selection
  await bp([{ _obj: "make", _target: [{ _ref: "contentLayer" }],
    using: { _obj: "contentLayer", type: { _obj: "solidColorLayer", color: { _obj: "RGBColor", red: r, grain: g, blue: b } } } }], "fill " + name);
  const layer = doc.activeLayers[0]; layer.name = name; return layer;
}
/* Type is the whole game and NOTHING is inherited — set font, size, tracking and
 * color explicitly via one textStyleRange (a partial range RESETS the rest). */
async function addText(doc, text, name, o) {
  await doc.createTextLayer({ contents: text, position: { x: o.x, y: o.y }, name });
  const [r, g, b] = o.color;
  const style = { _obj: "textStyle",
    fontPostScriptName: o.font, fontName: o.font,
    size: { _unit: "pointsUnit", _value: o.size },              // doc is 72dpi → pt == px
    color: { _obj: "RGBColor", red: r, grain: g, blue: b } };
  if (o.tracking != null) style.tracking = o.tracking;          // 1/1000 em
  await bp([{ _obj: "set", _target: [{ _ref: "textLayer", _enum: "ordinal", _value: "targetEnum" }],
    to: { _obj: "textLayer", textStyleRange: [{ _obj: "textStyleRange", from: 0, to: text.length, textStyle: style }] } }], "style " + name);
}

// ============================ YOUR WORK BELOW ===============================
// Editorial portrait. Off-white paper, near-black ink, one warm accent, huge
// serif display, lots of negative space. Sizing in proportions of H.
const W = 1080, H = 1350, M = 110;                 // ~10% margin — generous, editorial
const PAPER = [243, 239, 231], INK = [26, 25, 22], ACCENT = [156, 74, 47];   // warm off-white / near-black / clay

const doc = await app.createDocument({ width: W, height: H, resolution: 72, name: "poster", fill: "white" });
await deselect();
await fillLayer(doc, PAPER, "paper");

// Kicker — tracked small caps, top margin, in the accent. A short hairline rule under it.
await addText(doc, "HYDRATION — NO. 01", "kicker", { x: M, y: 190, size: 26, tracking: 360, font: "HelveticaNeue-Medium", color: ACCENT });
await selectRect(228, M, 230, M + 90);             // 2px hairline rule
await fillLayer(doc, ACCENT, "rule"); await deselect();

// Display headline — Didot, oversized, lower third, tight stack (one layer per line).
await addText(doc, "Drink",      "h1", { x: M, y: 880,  size: 184, tracking: -10, font: "Didot",        color: INK });
await addText(doc, "More Water", "h2", { x: M, y: 1050, size: 184, tracking: -10, font: "Didot",        color: INK });

// Caption — serif italic, quiet, near the bottom margin.
await addText(doc, "Aim for eight glasses a day.", "caption", { x: M, y: 1245, size: 40, font: "Baskerville-Italic", color: INK });

await emit(doc, { note: "01 — editorial type poster" });
// ===========================================================================
